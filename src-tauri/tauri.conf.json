{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EchoTransfer",
  "version": "0.2.1",
  "identifier": "com.tsvetomirgt.echotransfer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "EchoTransfer",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 540,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "license": "GPL-3.0-or-later",
    "copyright": "Copyright (C) 2026 Tsvetomir Tsvetkov. Licensed under GPL-3.0-or-later.",
    "homepage": "https://github.com/TsvetomirGT/echotransfer",
    "publisher": "Tsvetomir Tsvetkov",
    "category": "Music",
    "shortDescription": "Sync Navidrome music to a Snowsky Echo SD card"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZENTg4QzcyRUY1NzBFMDkKUldRSkRsZnZjb3hZYlU1VTgwWWMzR25nU0R1UVFwSk43UmZXdnJuakRmdC9TUUwxQndIb0U0eEIK",
      "endpoints": [
        "https://github.com/TsvetomirGT/echotransfer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
